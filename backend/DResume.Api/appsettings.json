{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "DainnUser": {
    "Database": {
      "Provider": "PostgreSQL",
      "ConnectionString": ""
    },
    "Jwt": {
      "Secret": "",
      "Issuer": "DResume",
      "Audience": "DResumeApp",
      "ValidateIssuer": true,
      "ValidateAudience": true,
      "ClockSkewSeconds": 30
    },
    "Email": {
      "Provider": "Smtp",
      "FromEmail": "noreply@dresume.local",
      "FromName": "DResume",
      "SmtpHost": "localhost",
      "SmtpPort": 1025,
      "SmtpUsername": "",
      "SmtpPassword": "",
      "EnableSsl": false
    },
    "EnableSocialLogin": true,
    "GoogleClientId": "",
    "GoogleClientSecret": "",
    "GoogleCallbackPath": "/api/auth/google/callback",
    "EnableTwoFactor": false,
    "RequireEmailVerification": true,
    "EnableAccountLockout": true,
    "EnableSessionManagement": true,
    "EnableActivityLogging": true,
    "EnableRateLimiting": true,
    "EnableGenericOidc": false,
    "JwtExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7,
    "MaxFailedLoginAttempts": 5,
    "LockoutDurationMinutes": 15
  },

  "Resume": {
    "ConnectionString": ""
  },

  "Anthropic": {
    "ApiKey": "",
    "BaseUrl": "https://open-api.dainn.online/v1",
    "Model": "gpt-5.5",
    "ApiVersion": "2023-06-01",
    "TimeoutSeconds": 120
  },

  "Recaptcha": {
    "Enabled": false,
    "SecretKey": "",
    "VerifyUrl": "https://www.google.com/recaptcha/api/siteverify"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },

  "Upload": {
    "MaxBytes": 10485760
  },

  "DainnStripe": {
    "Enabled": false,
    "Database": {
      "Provider": "PostgreSQL",
      "ConnectionString": ""
    },
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSigningSecret": "",
    "WebhookToleranceSeconds": 300,
    "WebhookPath": "/api/billing/webhook",
    "ThrowOnApiVersionMismatch": false
  },

  "ConnectionStrings": {
    "DainnStripe": ""
  },

  "Billing": {
    "SuccessUrl": "http://localhost:3000/account?checkout=success&session_id={CHECKOUT_SESSION_ID}",
    "CancelUrl": "http://localhost:3000/account?checkout=cancel",
    "SeedCatalogOnStartup": true,
    "CardPaymentsEnabled": false,
    "BankQrEnabled": true,
    "TestPlanEnabled": false,
    "TestPlanPriceVnd": 2000,
    "BankWebhookSecret": ""
  },

  "Admin": {
    "Emails": [ "admin@dainn.online" ]
  },

  "Support": {
    "BugReportEmail": "admin@dainn.online"
  }
}
