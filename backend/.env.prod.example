# Copy to .env.prod and fill in real values before running:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# ───────── Database ─────────
POSTGRES_DB=dresume
POSTGRES_USER=dresume
POSTGRES_PASSWORD=change-me-strong-password

# ───────── Auth (REQUIRED) ─────────
# Generate: openssl rand -base64 64   (or PowerShell:
#   [Convert]::ToBase64String((1..64|%{Get-Random -Max 256})) )
JWT_SECRET=change-me-base64-64-byte-secret

# ───────── AI (REQUIRED) ─────────
# Key for the Anthropic-compatible endpoint (BaseUrl set in appsettings.json)
ANTHROPIC_API_KEY=sk-xxxxxxxxxxxxxxxx

# ───────── Stripe (card payments) ─────────
# Set STRIPE_ENABLED=false to run without card billing (bank QR still works).
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=sk_live_xxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# ───────── Bank QR payments ─────────
# Secret used to verify incoming bank-payment webhooks
BANK_WEBHOOK_SECRET=change-me-bank-webhook-secret

# ───────── SMTP (real provider, NOT MailHog) ─────────
# SendGrid example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USERNAME=apikey
#   SMTP_PASSWORD=SG.xxxxxxxxxxxxx
#
# AWS SES example:
#   SMTP_HOST=email-smtp.us-east-1.amazonaws.com
#   SMTP_PORT=587
#   SMTP_USERNAME=AKIAxxxxxxxx
#   SMTP_PASSWORD=base64-encoded-smtp-password
#
# Mailgun example:
#   SMTP_HOST=smtp.mailgun.org
#   SMTP_PORT=587
#   SMTP_USERNAME=postmaster@mg.yourdomain.com
#   SMTP_PASSWORD=xxxxxxxx

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your-smtp-password
SMTP_ENABLE_SSL=true
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=DResume

# ───────── Public URLs ─────────
FRONTEND_ORIGIN=https://app.yourdomain.com
