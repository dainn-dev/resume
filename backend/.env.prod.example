# Copy to .env.prod and fill in real values before running:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# ───────── Database ─────────
POSTGRES_DB=dresume
POSTGRES_USER=dresume
POSTGRES_PASSWORD=change-me-strong-password

# ───────── SMTP (real provider, NOT MailHog) ─────────
# SendGrid example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USERNAME=apikey
#   SMTP_PASSWORD=SG.xxxxxxxxxxxxx
#
# AWS SES example:
#   SMTP_HOST=email-smtp.us-east-1.amazonaws.com
#   SMTP_PORT=587
#   SMTP_USERNAME=AKIAxxxxxxxx
#   SMTP_PASSWORD=base64-encoded-smtp-password
#
# Mailgun example:
#   SMTP_HOST=smtp.mailgun.org
#   SMTP_PORT=587
#   SMTP_USERNAME=postmaster@mg.yourdomain.com
#   SMTP_PASSWORD=xxxxxxxx

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your-smtp-password
SMTP_ENABLE_SSL=true
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=DResume

# ───────── Public URLs ─────────
FRONTEND_ORIGIN=https://app.yourdomain.com
